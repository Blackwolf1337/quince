// The main window of the Slint frontend (qml/Main.qml). The globals mirror
// the core (globals.slint); src/slint/Bindings.cpp keeps them in step.

import { LineEdit } from "std-widgets.slint";
import { Style } from "style.slint";
import { Icons } from "icons.slint";
import { Art, ToolButton } from "widgets.slint";
import { Sidebar } from "sidebar.slint";
import { PlayerBar } from "player-bar.slint";
import { QueuePanel } from "queue-panel.slint";
import { Account, App, Player, PlaylistEntry, QueueRow } from "globals.slint";

import "../qml/fonts/InterVariable.ttf";

export { Style, Account, App, Player, PlaylistEntry, QueueRow }

// errors and short messages, for a while above the player bar
component Toast inherits Rectangle {
    private property <int> serial: App.toast-serial;
    private property <bool> shown;

    changed serial => {
        root.shown = App.toast != "";
        hide.running = false;
        hide.running = root.shown;
    }

    width: Math.min(label.preferred-width + 40px, 640px);
    height: label.preferred-height + 24px;
    border-radius: self.height / 2;
    background: App.toast-error ? #5a2028f8 : Style.surface-high.with-alpha(0.97);
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Style.normal; easing: cubic-bezier(0.33, 1, 0.68, 1); }

    label := Text {
        width: Math.min(self.preferred-width, 600px);
        text: App.toast;
        color: App.toast-error ? #ffd9dc : Style.text;
        wrap: word-wrap;
        horizontal-alignment: center;
    }

    hide := Timer {
        interval: 6s;
        running: false;
        triggered => {
            root.shown = false;
            self.running = false;
        }
    }
}

// the volume, for a moment after it changed by wheel or keys
component VolumeHud inherits Rectangle {
    private property <float> volume: Player.volume;
    // the first value is the start-up one, not a change
    private property <bool> armed;
    private property <bool> shown;

    changed volume => {
        if root.armed {
            root.shown = true;
            hide.running = false;
            hide.running = true;
        }
        root.armed = true;
    }

    width: 220px;
    height: 64px;
    border-radius: self.height / 2;
    background: Style.surface-high.with-alpha(0.97);
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Style.normal; }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 22px;
        spacing: 12px;
        Image {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            source: Player.muted || Player.volume <= 0 ? Icons.volume-off : Icons.volume;
            colorize: Style.text;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: #ffffff33;
            Rectangle {
                x: 0;
                width: parent.width * Player.volume / 100;
                border-radius: 3px;
                background: Style.accent;
                animate width { duration: Style.fast; }
            }
        }
        Text {
            width: 30px;
            text: Math.round(Player.volume);
            color: Style.text;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    hide := Timer {
        interval: 1.2s;
        running: false;
        triggered => {
            root.shown = false;
            self.running = false;
        }
    }
}

export component MainWindow inherits Window {
    title: Player.title != "" ? Player.title + " - Quince" : "Quince";
    icon: Icons.quince;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 820px;
    min-height: 520px;
    // FemtoVG clears with this, mpv draws next, the items come on top: nothing
    // opaque may lie over the video area
    background: Style.background;
    default-font-family: "Inter Variable";
    default-font-size: 14px;

    // the video area for src/slint/VideoRenderer.cpp
    out property <bool> video-shown: Player.video-playing;
    out property <length> video-x: video.absolute-position.x;
    out property <length> video-y: video.absolute-position.y;
    out property <length> video-width: video.width;
    out property <length> video-height: video.height;

    callback now-playing-requested();
    callback mini-player-requested();

    // the system clipboard through a hidden text field (Slint has no API for it)
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
    }

    keys := FocusScope {
        init => {
            self.focus();
        }

        key-pressed(event) => {
            if event.modifiers.control && event.text == Key.RightArrow {
                Player.next();
                return accept;
            }
            if event.modifiers.control && event.text == Key.LeftArrow {
                Player.previous();
                return accept;
            }
            if event.modifiers.control && event.text == Key.UpArrow {
                Player.set-volume(Math.min(Player.volume + Player.volume-step, 100));
                return accept;
            }
            if event.modifiers.control && event.text == Key.DownArrow {
                Player.set-volume(Math.max(Player.volume - Player.volume-step, 0));
                return accept;
            }
            if event.modifiers.control && (event.text == "l" || event.text == "L") {
                App.queue-open = true;
                App.queue-tab = 1;
                return accept;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) || event.text == "/" {
                search.focus();
                return accept;
            }
            if event.modifiers.control || event.modifiers.alt {
                return reject;
            }
            if event.text == " " {
                Player.toggle-pause();
                return accept;
            }
            if event.text == "m" || event.text == "M" {
                Player.set-muted(!Player.muted);
                return accept;
            }
            reject
        }

        VerticalLayout {
            // back and forward, search, clock
            HorizontalLayout {
                height: 64px;
                padding-left: 12px;
                padding-right: 16px;
                spacing: 2px;

                ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.back;
                    enabled: false;
                }
                ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.back;
                    rotation: 180;
                    enabled: false;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                search := LineEdit {
                    horizontal-stretch: 6;
                    max-width: 560px;
                    height: 40px;
                    y: (parent.height - self.height) / 2;
                    placeholder-text: @tr("Search songs, albums, artists");
                    accepted(text) => {
                        Player.play-text(text);
                        self.text = "";
                        keys.focus();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    visible: App.clock != "";
                    text: App.clock;
                    color: Style.text-dim;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                // keeps the search centered against the two buttons on the left
                Rectangle {
                    width: App.clock != "" ? 0px : 80px;
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                Sidebar {
                    width: App.compact-sidebar ? 72px : 232px;
                    animate width { duration: Style.normal; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                }

                // the pages lie on a slightly lighter, rounded sheet
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Style.radius-large;
                    border-width: 1px;
                    border-color: Style.line;
                    // see-through where the video is (mpv draws under the items)
                    background: Player.video-playing ? transparent : Style.surface.with-alpha(0.42);
                    clip: true;

                    video := Rectangle {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: parent.height - 32px;
                    }

                    if !Player.video-playing: VerticalLayout {
                        alignment: center;
                        spacing: 16px;
                        HorizontalLayout {
                            alignment: center;
                            Art {
                                width: 320px;
                                height: 320px;
                                corner: 12px;
                                source: Player.art;
                            }
                        }
                        Text {
                            text: Player.title;
                            color: Style.text;
                            font-size: 22px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: Player.subtitle;
                            color: Style.text-dim;
                            horizontal-alignment: center;
                        }
                    }
                }

                // a gap like the queue panel's when it is closed
                Rectangle {
                    width: App.queue-open ? 380px : 12px;
                    clip: true;
                    animate width { duration: Style.normal; easing: cubic-bezier(0.33, 1, 0.68, 1); }

                    QueuePanel {
                        x: 0;
                        width: 380px;
                        visible: parent.width > 13px;
                    }
                }
            }

            PlayerBar {
                now-playing-requested => {
                    root.now-playing-requested();
                }
                mini-player-requested => {
                    root.mini-player-requested();
                }
            }
        }

        Toast {
            x: (parent.width - self.width) / 2;
            y: parent.height - 92px - 16px - self.height;
        }

        VolumeHud {
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.18;
        }
    }

    clip := TextInput {
        visible: false;
        width: 0;
        height: 0;
    }
}

// A SystemTrayIcon has its own copy of the globals: the C++ side feeds it
export component TrayIcon inherits SystemTrayIcon {
    icon: Icons.quince;
    in property <string> now-playing: @tr("Nothing playing");
    in property <bool> playing;
    tooltip: self.now-playing;
    title: "Quince";

    callback toggle-pause();
    callback next();
    callback previous();
    callback toggle-window();
    callback quit();

    Menu {
        MenuItem {
            title: root.now-playing;
            enabled: false;
        }
        MenuSeparator { }
        MenuItem {
            title: root.playing ? @tr("Pause") : @tr("Play");
            activated => {
                root.toggle-pause();
            }
        }
        MenuItem {
            title: @tr("Next");
            activated => {
                root.next();
            }
        }
        MenuItem {
            title: @tr("Previous");
            activated => {
                root.previous();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: @tr("Show or hide Quince");
            activated => {
                root.toggle-window();
            }
        }
        MenuItem {
            title: @tr("Quit");
            activated => {
                root.quit();
            }
        }
    }
}
