// The main window of the Quince window. The globals mirror
// the core (globals.slint); src/slint/Bindings.cpp keeps them in step.

import { Style } from "style.slint";
import { Icons } from "icons.slint";
import { ToolButton } from "widgets.slint";
import { Sidebar } from "sidebar.slint";
import { PlayerBar } from "player-bar.slint";
import { QueuePanel } from "queue-panel.slint";
import { Account, App, Player, PlaylistEntry, ListItem } from "globals.slint";
// the areas, each ported in its own files
import { Browse, BrowseView, PageMove } from "browse-view.slint";
import { SearchField } from "search-field.slint";
import { NowPlaying } from "now-playing.slint";
import { DialogLayer } from "dialogs.slint";
import { DownloadsView } from "downloads-view.slint";
import { Backdrop } from "backdrop.slint";
import { Frost, Frosted } from "frost.slint";

import "fonts/InterVariable.ttf";

export { Style, Account, App, Player, PlaylistEntry, ListItem, Browse, Frost }
export { Search } from "search-field.slint";
export { ItemMenu } from "item-menu.slint";

// errors and short messages, for a while above the player bar
component Toast inherits Frosted {
    private property <int> serial: App.toast-serial;
    private property <bool> shown;

    changed serial => {
        root.shown = App.toast != "";
        if root.shown {
            Frost.refresh();
        }
        hide.running = false;
        hide.running = root.shown;
    }

    width: Math.min(label.preferred-width + 40px, 640px);
    height: label.preferred-height + 24px;
    border-radius: self.height / 2;
    tint: App.toast-error ? #5a2028bf : Style.surface-high.with-alpha(0.7);
    plain-tint: App.toast-error ? #5a2028f8 : Style.surface-high.with-alpha(0.97);
    visible: !Frost.capturing;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Style.normal; easing: cubic-bezier(0.33, 1, 0.68, 1); }

    label := Text {
        width: Math.min(self.preferred-width, 600px);
        text: App.toast;
        color: App.toast-error ? #ffd9dc : Style.text;
        wrap: word-wrap;
        horizontal-alignment: center;
    }

    hide := Timer {
        interval: 6s;
        running: false;
        triggered => {
            root.shown = false;
            self.running = false;
        }
    }
}

// the volume, for a moment after it changed by wheel or keys
component VolumeHud inherits Frosted {
    private property <float> volume: Player.volume;
    // the first value is the start-up one, not a change
    private property <bool> armed;
    private property <bool> shown;

    changed volume => {
        if root.armed {
            if !root.shown {
                Frost.refresh();
            }
            root.shown = true;
            hide.running = false;
            hide.running = true;
        }
        root.armed = true;
    }

    width: 220px;
    height: 64px;
    border-radius: self.height / 2;
    visible: !Frost.capturing;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Style.normal; }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 22px;
        spacing: 12px;
        Image {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            source: Player.muted || Player.volume <= 0 ? Icons.volume-off : Icons.volume;
            colorize: Style.text;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: #ffffff33;
            Rectangle {
                x: 0;
                width: parent.width * Player.volume / 100;
                border-radius: 3px;
                background: Style.accent;
                animate width { duration: Style.fast; }
            }
        }
        Text {
            width: 30px;
            text: Math.round(Player.volume);
            color: Style.text;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    hide := Timer {
        interval: 1.2s;
        running: false;
        triggered => {
            root.shown = false;
            self.running = false;
        }
    }
}

export component MainWindow inherits Window {
    title: Player.title != "" ? Player.title + " - Quince" : "Quince";
    icon: Icons.quince;
    // the last size (main.cpp reads it before the window exists); the
    // compositor may still choose another
    in property <length> start-width: 1280px;
    in property <length> start-height: 800px;
    preferred-width: root.start-width;
    preferred-height: root.start-height;
    min-width: 820px;
    min-height: 520px;
    // FemtoVG clears with this, mpv draws next, the items come on top: nothing
    // opaque may lie over the video area. The window has an alpha channel
    // (Slint's winit windows do on Linux and Windows), so it can be see-through.
    background: App.settings.transparent-window ? transparent : Style.background;
    default-font-family: "Inter Variable";
    default-font-size: 14px;

    // the video area for src/slint/VideoRenderer.cpp (in the Now Playing
    // view), and the picture it renders for it
    in property <image> video-frame;
    out property <bool> video-shown: now-playing.video-shown;
    out property <length> video-width: now-playing.video-width;
    out property <length> video-height: now-playing.video-height;

    callback mini-player-requested();

    // the system clipboard through a hidden text field (Slint has no API for it)
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
    }

    keys := FocusScope {
        init => {
            self.focus();
        }

        key-pressed(event) => {
            if event.modifiers.control && event.text == Key.RightArrow {
                Player.next();
                return accept;
            }
            if event.modifiers.control && event.text == Key.LeftArrow {
                Player.previous();
                return accept;
            }
            if event.modifiers.control && event.text == Key.UpArrow {
                Player.set-volume(Math.min(Player.volume + Player.volume-step, 100));
                return accept;
            }
            if event.modifiers.control && event.text == Key.DownArrow {
                Player.set-volume(Math.max(Player.volume - Player.volume-step, 0));
                return accept;
            }
            if event.modifiers.control && (event.text == "l" || event.text == "L") {
                App.queue-open = true;
                App.queue-tab = 1;
                return accept;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) || event.text == "/" {
                App.now-playing-open = false;
                search.focus-search();
                return accept;
            }
            if event.modifiers.control && event.modifiers.shift && (event.text == "m" || event.text == "M") {
                root.mini-player-requested();
                return accept;
            }
            if event.modifiers.control && (event.text == "p" || event.text == "P") {
                App.now-playing-open = !App.now-playing-open;
                return accept;
            }
            if event.modifiers.alt && event.text == Key.LeftArrow {
                Browse.back();
                return accept;
            }
            if event.modifiers.alt && event.text == Key.RightArrow {
                Browse.forward();
                return accept;
            }
            if event.text == Key.Escape && App.now-playing-open {
                App.now-playing-open = false;
                return accept;
            }
            if event.text == Key.Escape && Browse.selected-count > 0 {
                Browse.select(-1, "clear");
                return accept;
            }
            // every track of the open page, for the item menu
            if event.modifiers.control && (event.text == "a" || event.text == "A") && !App.now-playing-open {
                Browse.select(-1, "all");
                return accept;
            }
            if event.modifiers.control || event.modifiers.alt {
                return reject;
            }
            if event.text == " " {
                Player.toggle-pause();
                return accept;
            }
            if event.text == "m" || event.text == "M" {
                Player.set-muted(!Player.muted);
                return accept;
            }
            reject
        }

        // the window's own light; Now Playing has its own around the video
        Backdrop {
            width: 100%;
            height: 100%;
            visible: !App.now-playing-open;
            translucent: App.settings.transparent-window;
        }

        VerticalLayout {
            // nothing under the open Now Playing view may draw: mpv's video
            // lies under every Slint item
            visible: !App.now-playing-open;

            // back and forward, search, clock
            HorizontalLayout {
                height: 64px;
                padding-left: 12px;
                padding-right: 16px;
                spacing: 2px;

                ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.back;
                    tooltip: @tr("Back");
                    enabled: Browse.can-back;
                    clicked => {
                        Browse.back();
                    }
                }
                ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.back;
                    rotation: 180;
                    tooltip: @tr("Forward");
                    enabled: Browse.can-forward;
                    clicked => {
                        Browse.forward();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                search := SearchField {
                    horizontal-stretch: 6;
                    max-width: 560px;
                    height: 40px;
                    y: (parent.height - self.height) / 2;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    visible: App.clock != "";
                    text: App.clock;
                    color: Style.text-dim;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                // keeps the search centered against the two buttons on the left
                Rectangle {
                    width: App.clock != "" ? 0px : 80px;
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                Sidebar {
                    width: App.compact-sidebar ? 72px : 232px;
                    animate width { duration: Style.normal; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                }

                // the pages lie on a slightly lighter, rounded sheet
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Style.radius-large;
                    border-width: 1px;
                    border-color: Style.line;
                    background: Style.surface.with-alpha(0.42);
                    clip: true;

                    // a new page comes in from the
                    // right when opened, from the left when going back, rising
                    // for a section
                    page-area := Rectangle {
                        property <int> page: Browse.page-id;
                        // the entry's first step: straight to where it starts
                        property <bool> jump;
                        property <length> shift-x;
                        property <length> shift-y;
                        property <float> fade: 1;

                        x: self.shift-x;
                        y: self.shift-y;
                        width: parent.width;
                        height: parent.height;
                        opacity: self.fade;
                        animate shift-x, shift-y {
                            duration: page-area.jump ? 0 : Style.slow;
                            easing: cubic-bezier(0.33, 1, 0.68, 1);
                        }
                        animate fade {
                            duration: page-area.jump ? 0 : Style.normal;
                            easing: cubic-bezier(0.33, 1, 0.68, 1);
                        }

                        changed page => {
                            self.jump = true;
                            self.shift-x = Browse.page-move == PageMove.push ? 48px : Browse.page-move == PageMove.back ? -48px : 0;
                            self.shift-y = Browse.page-move == PageMove.section ? 16px : 0;
                            self.fade = 0;
                            enter.start();
                        }
                        enter := Timer {
                            interval: 1ms;
                            running: false;
                            triggered => {
                                self.stop();
                                page-area.jump = false;
                                page-area.shift-x = 0;
                                page-area.shift-y = 0;
                                page-area.fade = 1;
                            }
                        }

                        if App.section != "downloads": BrowseView {
                            width: 100%;
                            height: 100%;
                        }
                        if App.section == "downloads": DownloadsView {
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

                // a gap like the queue panel's when it is closed
                Rectangle {
                    width: App.queue-open ? 380px : 12px;
                    clip: true;
                    animate width { duration: Style.normal; easing: cubic-bezier(0.33, 1, 0.68, 1); }

                    QueuePanel {
                        x: 0;
                        width: 380px;
                        visible: parent.width > 13px;
                    }
                }
            }

            PlayerBar {
                now-playing-requested => {
                    App.now-playing-open = !App.now-playing-open;
                }
                mini-player-requested => {
                    root.mini-player-requested();
                }
            }
        }

        now-playing := NowPlaying {
            width: 100%;
            height: 100%;
            frame: root.video-frame;
        }

        Toast {
            x: (parent.width - self.width) / 2;
            y: parent.height - 92px - 16px - self.height;
        }

        VolumeHud {
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.18;
        }

        DialogLayer {
            width: 100%;
            height: 100%;
        }
    }

    clip := TextInput {
        visible: false;
        width: 0;
        height: 0;
    }
}

// A SystemTrayIcon has its own copy of the globals: the C++ side feeds it
export component TrayIcon inherits SystemTrayIcon {
    icon: Icons.quince;
    in property <string> now-playing: @tr("Nothing playing");
    in property <bool> playing;
    tooltip: self.now-playing;
    title: "Quince";

    callback toggle-pause();
    callback next();
    callback previous();
    callback toggle-window();
    callback quit();

    Menu {
        MenuItem {
            title: root.now-playing;
            enabled: false;
        }
        MenuSeparator { }
        MenuItem {
            title: root.playing ? @tr("Pause") : @tr("Play");
            activated => {
                root.toggle-pause();
            }
        }
        MenuItem {
            title: @tr("Next");
            activated => {
                root.next();
            }
        }
        MenuItem {
            title: @tr("Previous");
            activated => {
                root.previous();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: @tr("Show or hide Quince");
            activated => {
                root.toggle-window();
            }
        }
        MenuItem {
            title: @tr("Quit");
            activated => {
                root.quit();
            }
        }
    }
}
