// The core's state as the views see it. src/slint/Bindings.cpp keeps these in
// step with the core and hands the callbacks to the core thread.

import { Choice, DownloadRow, EffectsValues, Equalizer, SettingsValues } from "dialogs-data.slint";

// a track, album, artist or playlist as a list row
export struct ListItem {
    title: string,
    subtitle: string,
    art-url: string,
    art: image,
    duration: string,
    // artist (round cover) or a track
    kind: string,
    explicit: bool,
    unavailable: bool,
    current: bool,
    // the track number on an album page
    number: string,
}

// a line of the lyrics: time in seconds (-1 when not synced), the
// romanized line under it ("" none)
export struct LyricsLine {
    time: float,
    text: string,
    romanized: string,
}

// a caption track of the video playing
export struct Caption {
    name: string,
    generated: bool,
}

// what the mini player shows; the Now Playing view hands it over on every
// change (the mini player is a window of its own, with its own globals)
export struct MiniState {
    title: string,
    subtitle: string,
    art: image,
    playing: bool,
    has-next: bool,
    position: float,
    duration: float,
    like-status: string,
    can-rate: bool,
    // the video or the visualizer draws, and whether it is a video
    picture: bool,
    video: bool,
    restarts: int,
    accent: color,
    background: color,
}

export struct PlaylistEntry {
    title: string,
    browse-id: string,
}

export global Player {
    in property <string> title;
    in property <string> subtitle;
    in property <image> art;
    in property <string> video-id;
    // LIKE, DISLIKE or INDIFFERENT
    in property <string> like-status;
    in property <bool> paused: true;
    in property <bool> idle: true;
    in property <bool> buffering;
    in property <bool> loading;
    in property <float> position;
    in property <float> duration;
    // the settings' volume slider position, 0..100, and its step
    in property <float> volume;
    in property <float> volume-step: 5;
    in property <bool> muted;
    in property <bool> has-next;
    in property <bool> video-playing;
    in property <string> stream-info;
    in property <float> speed: 1;
    in property <string> error;
    in property <[ListItem]> queue;
    in property <int> queue-current: -1;

    callback toggle-pause();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback set-muted(bool);
    callback set-speed(float);
    callback play-index(int);
    callback play-text(string);
    callback rate(string);
    callback shuffle-rest();
    callback clear-rest();

    // area C: Now Playing, lyrics, mini player (NowPlayingBindings.cpp)
    in property <string> album;
    // the cover small and blurred, for backdrops (Slint has no live blur)
    in property <image> art-blurred;
    // counts mpv's restarts (a new file, a seek): a video's first frame is near
    in property <int> restarts;
    in property <[LyricsLine]> lyrics;
    in property <bool> lyrics-synced;
    in property <bool> lyrics-loading;
    // the line sung now, -1 for none
    in property <int> lyrics-line: -1;
    in property <string> lyrics-source;
    in property <string> lyrics-source-url;
    in property <[Caption]> captions;
    // the caption shown, -1 for none
    in property <int> caption: -1;

    callback set-caption(int);

    // m:ss, or h:mm:ss from an hour on
    public pure function time(seconds: float) -> string {
        if seconds < 0 || seconds != seconds {
            return "0:00";
        }
        let total = Math.floor(seconds);
        let secs = Math.mod(total, 60);
        let minutes = Math.floor(total / 60);
        let tail = (secs < 10 ? ":0" : ":") + secs;
        if minutes >= 60 {
            let rest = Math.mod(minutes, 60);
            return Math.floor(minutes / 60) + (rest < 10 ? ":0" : ":") + rest + tail;
        }
        return minutes + tail;
    }
}

export global Account {
    in property <bool> signed-in;
    in property <string> name;
    in property <string> handle;
    in property <image> photo;
    in property <[PlaylistEntry]> playlists;

    callback sign-in();
    callback sign-out();

    // area D: the sign-in dialog and the playlist picker (DialogsBindings.cpp)
    in property <bool> busy;
    // the browsers whose session can be taken
    in property <[Choice]> browsers;
    // the playlists the account owns, the ones an item can go into
    in property <[PlaylistEntry]> own-playlists;
    callback import-from-browser(string);
    // picks a cookies.txt file: the picker's title and filter name
    callback import-cookies(string, string);
    // the item the picker was opened for goes into a playlist (browse id,
    // title), or into a new one (title)
    callback add-to-playlist(string, string);
    callback create-playlist(string);
}

// The window's own state and the settings it shows.
export global App {
    // the open section: home, explore, library, liked, history, downloads, or a playlist's browse id
    in-out property <string> section: "home";
    in-out property <bool> queue-open;
    in-out property <int> queue-tab;

    in property <bool> compact-sidebar;
    in property <bool> colored-progress;
    in property <bool> video-mode;
    in property <int> downloads-running;
    // empty while the clock is off
    in property <string> clock;

    // a short message above the player bar; serial changes with each one
    in property <string> toast;
    in property <bool> toast-error;
    in property <int> toast-serial;

    // the Now Playing view covers the window (area C)
    in-out property <bool> now-playing-open;
    // the dialog shown (settings, equalizer, signin, addToPlaylist), empty for none (area D)
    in-out property <string> dialog;

    // area C: the look and lyrics settings of the Now Playing view
    in property <color> glow: #ffc83d;
    // the glows' strength (1 as designed), the video's ambient light and its reach
    in property <float> glow-scale: 1;
    in property <float> ambient-strength: 0.6;
    in property <float> ambient-size: 1;
    // "" off, or bars, wave, spectrum, scope
    in property <string> visualizer;
    in property <int> video-height: 1080;
    // fancy, scale, offset or focus
    in property <string> lyrics-effect: "fancy";
    in property <bool> lyrics-time-codes;
    in property <string> lyrics-gap-text: "♪";
    // the mini player has the video; the main window is hidden
    in-out property <bool> mini-player-open;

    callback set-visualizer(string);
    callback set-video-height(int);
    callback mini-state-changed(MiniState);

    callback section-requested(string, string);
    callback set-video-mode(bool);
    callback request-dialog(string);

    // area D (DialogsBindings.cpp): the settings and sound effects, edited in
    // place; the edited callbacks hand them to the core
    in-out property <SettingsValues> settings;
    in-out property <EffectsValues> effects;
    callback settings-edited();
    callback effects-edited();
    in property <Equalizer> equalizer;
    callback set-band(int, float);
    callback apply-preset(string);
    // the outputs of the audio backend and the one in use
    in property <[Choice]> audio-devices;
    in property <string> audio-device;
    // a folder picker for the downloads
    callback choose-download-folder();

    // the downloads of this session and their folder
    in property <[DownloadRow]> downloads;
    in property <string> download-folder;
    // a row, or -1 for the folder itself
    callback open-download-folder(int);
    callback retry-download(int);
    callback clear-finished-downloads();
}
