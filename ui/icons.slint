// The icons of the QML frontend (qml/icons), embedded at build time.

export global Icons {
    out property <image> account: @image-url("../qml/icons/account.svg");
    out property <image> back: @image-url("../qml/icons/back.svg");
    out property <image> broadcast: @image-url("../qml/icons/broadcast.svg");
    out property <image> captions: @image-url("../qml/icons/captions.svg");
    out property <image> chevron-down: @image-url("../qml/icons/chevron-down.svg");
    out property <image> chevron-left: @image-url("../qml/icons/chevron-left.svg");
    out property <image> chevron-right: @image-url("../qml/icons/chevron-right.svg");
    out property <image> close: @image-url("../qml/icons/close.svg");
    out property <image> dislike: @image-url("../qml/icons/dislike.svg");
    out property <image> download: @image-url("../qml/icons/download.svg");
    out property <image> explore: @image-url("../qml/icons/explore.svg");
    out property <image> heart: @image-url("../qml/icons/heart.svg");
    out property <image> history: @image-url("../qml/icons/history.svg");
    out property <image> home: @image-url("../qml/icons/home.svg");
    out property <image> library: @image-url("../qml/icons/library.svg");
    out property <image> like: @image-url("../qml/icons/like.svg");
    out property <image> miniplayer: @image-url("../qml/icons/miniplayer.svg");
    out property <image> monitor: @image-url("../qml/icons/monitor.svg");
    out property <image> more: @image-url("../qml/icons/more.svg");
    out property <image> next: @image-url("../qml/icons/next.svg");
    out property <image> palette: @image-url("../qml/icons/palette.svg");
    out property <image> pause: @image-url("../qml/icons/pause.svg");
    out property <image> playlist: @image-url("../qml/icons/playlist.svg");
    out property <image> play: @image-url("../qml/icons/play.svg");
    out property <image> previous: @image-url("../qml/icons/previous.svg");
    out property <image> queue: @image-url("../qml/icons/queue.svg");
    out property <image> radio: @image-url("../qml/icons/radio.svg");
    out property <image> search: @image-url("../qml/icons/search.svg");
    out property <image> settings: @image-url("../qml/icons/settings.svg");
    out property <image> shuffle: @image-url("../qml/icons/shuffle.svg");
    out property <image> video: @image-url("../qml/icons/video.svg");
    out property <image> visualizer: @image-url("../qml/icons/visualizer.svg");
    out property <image> volume-off: @image-url("../qml/icons/volume-off.svg");
    out property <image> volume: @image-url("../qml/icons/volume.svg");
    out property <image> quince: @image-url("../qml/icons/quince.svg");
}
