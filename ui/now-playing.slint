// Area C: the playing track over the whole window: a
// large cover with its light, or the video, the controls, and lyrics or the
// queue beside it. The cover grows out of the player bar when it opens.
//
// mpv draws the video under all Slint items, into the rect video-* tells
// src/slint/VideoRenderer.cpp; nothing here draws over that rect while a
// video shows, the backdrop leaves it free.

import { TrackLinks } from "track-links.slint";
import { Style } from "style.slint";
import { Icons } from "icons.slint";
import { ThinSlider, ToolButton } from "widgets.slint";
import { QueuePanel } from "queue-panel.slint";
import { Glow } from "backdrop.slint";
import { ChoiceItem, FadeArt, MenuButton, PillButton, RoundPlayButton } from "np-widgets.slint";
import { Account, App, MiniState, Player } from "globals.slint";

// The backdrop over the whole view: the cover, blurred, darkened, with the
// light behind the cover and the video's ambient light.
component BackdropLayer inherits Rectangle {
    in property <length> cover-x;
    in property <length> cover-y;
    in property <length> cover-width;
    in property <length> cover-height;
    // the video's ambient light, 0 while none shows
    in property <float> ambient;

    Rectangle {
        background: Style.background;
    }
    Image {
        width: Math.max(root.width, root.height) * 1.15;
        height: self.width;
        source: Player.art-blurred;
        image-fit: fill;
        opacity: 0.85;
    }
    Rectangle {
        background: @linear-gradient(180deg, Style.background.with-alpha(0.35) 0%, Style.background.with-alpha(0.85) 100%);
    }
    // ambient mode: the video's light, its reach grows with the size setting
    Glow {
        width: Math.max(root.cover-width, root.cover-height) * (1.3 + 0.3 * App.ambient-size);
        height: self.width;
        x: root.cover-x + root.cover-width / 2 - self.width / 2;
        y: root.cover-y + root.cover-height / 2 - self.height / 2;
        strength: root.ambient;
        visible: root.ambient > 0;
    }
    // light behind the cover
    Glow {
        width: Math.max(root.cover-width * 2.4, 400px);
        height: self.width;
        x: root.cover-x + root.cover-width / 2 - self.width / 2;
        y: root.cover-y + root.cover-height / 2 - self.height / 2;
        strength: 0.55;
    }
}

// a part of the backdrop: the layer seen through a rect of the view
component BackdropPart inherits Rectangle {
    in property <length> cover-x;
    in property <length> cover-y;
    in property <length> cover-width;
    in property <length> cover-height;
    in property <float> ambient;
    in property <length> view-width;
    in property <length> view-height;

    clip: true;

    BackdropLayer {
        x: -root.x;
        y: -root.y;
        width: root.view-width;
        height: root.view-height;
        cover-x: root.cover-x;
        cover-y: root.cover-y;
        cover-width: root.cover-width;
        cover-height: root.cover-height;
        ambient: root.ambient;
    }
}

export component NowPlaying inherits Rectangle {
    // where mpv draws (src/slint/VideoRenderer.cpp reads it through MainWindow)
    // the picture mpv renders (src/slint/VideoRenderer.cpp)
    in property <image> frame;
    out property <bool> video-shown: root.progress > 0 && root.picture && !App.mini-player-open;
    out property <length> video-width: root.cover-width;
    out property <length> video-height: root.cover-height;

    private property <bool> open: App.now-playing-open;
    // 0 closed .. 1 open
    private property <float> progress: root.open ? 1 : 0;
    animate progress { duration: Style.slow + 60ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

    // mpv draws a picture: the video, or a visualizer while no video plays
    private property <bool> picture: Player.video-playing || App.visualizer != "";

    // where the cover (or the video) sits when open
    private property <length> slot-width: root.picture
        ? Math.max(320px, Math.min(root.width * 0.52, (root.height - 400px) * 16 / 9))
        : Math.max(200px, Math.min(520px, root.width * 0.38, root.height - 400px));
    animate slot-width { duration: Style.slow; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    private property <length> slot-height: root.picture ? root.slot-width * 9 / 16 : root.slot-width;

    // the cover, on its way between the player bar's cover (about where
    // player-bar.slint puts it) and its place
    private property <length> from-x: 280px;
    private property <length> from-y: root.height - 67px;
    private property <length> from-size: 56px;
    private property <length> cover-x: root.mix(root.from-x, slot.absolute-position.x - root.absolute-position.x);
    private property <length> cover-y: root.mix(root.from-y, slot.absolute-position.y - root.absolute-position.y);
    private property <length> cover-width: root.mix(root.from-size, slot.width);
    private property <length> cover-height: root.mix(root.from-size, slot.height);

    // the backdrop leaves the video's rect free

    // The first frame came: the cover stays until the video runs (opening
    // may load the track again with its picture).
    private property <bool> video-ready;
    private property <int> restarts: Player.restarts;
    changed video-shown => {
        root.video-ready = false;
    }
    changed restarts => {
        if root.video-shown {
            ready-timer.running = true;
        }
    }
    ready-timer := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            root.video-ready = true;
            self.running = false;
        }
    }
    // a visualizer switched on mid-track may not restart playback
    Timer {
        interval: 1500ms;
        running: root.video-shown && !Player.video-playing && !root.video-ready;
        triggered => {
            root.video-ready = true;
        }
    }

    // its own tab in the side panel, which is hidden meanwhile: lyrics at first
    private property <int> own-tab: 1;
    private property <int> side-tab;
    changed open => {
        if root.open {
            root.side-tab = App.queue-tab;
            App.queue-tab = root.own-tab;
            if Player.video-id == "" {
                App.now-playing-open = false;
            }
        } else {
            root.own-tab = App.queue-tab;
            App.queue-tab = root.side-tab;
        }
    }
    private property <string> video-id: Player.video-id;
    changed video-id => {
        if root.video-id == "" {
            App.now-playing-open = false;
        }
    }

    // the mini player is a window of its own: it gets what it shows from here
    private property <MiniState> mini: {
        title: Player.title,
        subtitle: Player.subtitle,
        art: Player.art,
        playing: !Player.paused && !Player.idle,
        has-next: Player.has-next,
        position: Player.position,
        duration: Player.duration,
        like-status: Player.like-status,
        can-rate: Account.signed-in && Player.video-id != "",
        picture: root.picture,
        video: Player.video-playing,
        restarts: Player.restarts,
        accent: Style.accent,
        background: Style.background,
    };
    private property <bool> mini-open: App.mini-player-open;
    changed mini => {
        App.mini-state-changed(root.mini);
    }
    changed mini-open => {
        App.mini-state-changed(root.mini);
    }

    private property <[string]> visualizers: ["", "spectrum", "bars", "wave", "scope"];
    private property <[string]> visualizer-names: [@tr("Off"), @tr("Spectrum"), @tr("Bars"), @tr("Wave"), @tr("Stereo scope")];

    pure function mix(a: length, b: length) -> length {
        return a + (b - a) * root.progress;
    }

    visible: root.progress > 0;

    // swallows clicks and the wheel so nothing behind reacts
    TouchArea {
        enabled: root.open;
        scroll-event(event) => {
            accept
        }
    }

    // the backdrop: the picture is a part of the scene, so it lies behind it
    Rectangle {
        opacity: root.progress;

        BackdropPart {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            cover-x: root.cover-x;
            cover-y: root.cover-y;
            cover-width: root.cover-width;
            cover-height: root.cover-height;
            ambient: root.video-ready ? App.ambient-strength : 0;
            view-width: root.width;
            view-height: root.height;
        }
    }

    ToolButton {
        x: 16px;
        y: 14px;
        icon: Icons.chevron-left;
        rotation: -90;
        opacity: root.progress;
        tooltip: @tr("Close");
        clicked => {
            App.now-playing-open = false;
        }
    }

    HorizontalLayout {
        y: (1 - root.progress) * 40px;
        width: 100%;
        height: 100%;
        padding-left: 64px;
        padding-right: 48px;
        padding-top: 64px;
        padding-bottom: 40px;
        spacing: 56px;
        opacity: Math.max(0, root.progress * 1.4 - 0.4);

        // both columns grow in proportion to their preferred widths, as in
        // a layout without stretch factors; the
        // cover keeps its size at the left
        VerticalLayout {
            min-width: root.slot-width;
            preferred-width: root.slot-width;
            horizontal-stretch: root.slot-width / 1px;
            spacing: 14px;

            // centered between two spacers; when it does not fit, the
            // top one is gone and the rest runs off the bottom
            Rectangle {
                vertical-stretch: 1;
            }

            // the cover itself flies above
            HorizontalLayout {
                alignment: start;
                slot := Rectangle {
                    width: root.slot-width;
                    height: root.slot-height;
                }
            }

            VerticalLayout {
                padding-top: 14px;
                Text {
                    text: Player.title;
                    color: Style.text;
                    font-size: 28px;
                    font-weight: 700;
                    overflow: elide;
                }
            }
            TrackLinks {
                font-size: 16px;
            }

            // the track 24 px down as in Qt Quick's Material Slider, the times 28 px under
            // it
            VerticalLayout {
                padding-top: 8px;
                spacing: 0;

                Rectangle {
                    height: 52px;

                    seek := ThinSlider {
                        y: 0;
                        height: 48px;
                        minimum: 0;
                        maximum: Math.max(Player.duration, 0.01);
                        value: Player.position;
                        enabled: Player.duration > 0;
                        fill: Style.accent;
                        track: Style.accent.with-alpha(0.3);
                        thickness: 4px;
                        active-thickness: 4px;
                        knob-always: true;
                        knob-color: Style.accent;
                        released(value) => {
                            Player.seek(value);
                        }
                    }
                }
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: Player.time(seek.shown);
                        color: Style.text-dim;
                        font-size: 12px;
                    }
                    Text {
                        text: Player.time(Player.duration);
                        color: Style.text-dim;
                        font-size: 12px;
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 18px;

                if Account.signed-in: ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.like;
                    checked: Player.like-status == "LIKE";
                    clicked => {
                        Player.rate(self.checked ? "INDIFFERENT" : "LIKE");
                    }
                }
                ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.previous;
                    icon-size: 28px;
                    clicked => {
                        Player.previous();
                    }
                }
                RoundPlayButton {
                    playing: !Player.paused && !Player.idle;
                    play-icon: Icons.play;
                    pause-icon: Icons.pause;
                    clicked => {
                        Player.toggle-pause();
                    }
                }
                ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.next;
                    icon-size: 28px;
                    enabled: Player.has-next;
                    clicked => {
                        Player.next();
                    }
                }
                if Account.signed-in: ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.dislike;
                    checked: Player.like-status == "DISLIKE";
                    clicked => {
                        Player.rate(self.checked ? "INDIFFERENT" : "DISLIKE");
                    }
                }
            }

            // video-toggle, its quality and captions; the visualizer
            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                if !Player.video-playing: MenuButton {
                    icon: Icons.visualizer;
                    checked: App.visualizer != "";
                    tooltip: @tr("Visualizer");
                    for id[index] in root.visualizers: ChoiceItem {
                        label: root.visualizer-names[index];
                        checked: App.visualizer == id;
                        picked => {
                            App.set-visualizer(id);
                        }
                    }
                }
                PillButton {
                    icon: Icons.video;
                    text: App.video-mode ? @tr("Video") : @tr("Song");
                    checked: App.video-mode;
                    tooltip: @tr("Switch between song and music video");
                    clicked => {
                        App.set-video-mode(!App.video-mode);
                    }
                }
                if Player.video-playing: MenuButton {
                    text: App.video-height + "p";
                    tooltip: @tr("Video quality");
                    for height in [2160, 1440, 1080, 720, 480, 360]: ChoiceItem {
                        label: height + "p";
                        checked: App.video-height == height;
                        picked => {
                            App.set-video-height(height);
                        }
                    }
                }
                if Player.video-playing && Player.captions.length > 0: MenuButton {
                    icon: Icons.captions;
                    checked: Player.caption >= 0;
                    tooltip: @tr("Captions");
                    ChoiceItem {
                        label: @tr("Off");
                        checked: Player.caption < 0;
                        picked => {
                            Player.set-caption(-1);
                        }
                    }
                    for caption[index] in Player.captions: ChoiceItem {
                        label: caption.generated ? caption.name + " " + @tr("(generated)") : caption.name;
                        checked: Player.caption == index;
                        picked => {
                            Player.set-caption(index);
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        // the queue panel's preferred width comes from the lyrics (the
        // widest line); this is about what it comes to
        QueuePanel {
            min-width: 320px;
            preferred-width: 333px;
            horizontal-stretch: 333;
        }
    }

    // the video (black around it), or the visualizer over the backdrop. No
    // clip with round corners: FemtoVG keeps a clipped
    // item as a layer and would not see the texture change
    if root.video-shown: Rectangle {
        x: root.cover-x;
        y: root.cover-y;
        width: root.cover-width;
        height: root.cover-height;
        background: Player.video-playing ? black : transparent;

        Image {
            width: 100%;
            height: 100%;
            source: root.frame;
            image-fit: fill;
        }
    }

    FadeArt {
        x: root.cover-x;
        y: root.cover-y;
        width: root.cover-width;
        height: root.cover-height;
        corner: root.mix(8px, Style.radius-large);
        source: Player.art;
        opacity: root.video-shown && root.video-ready ? 0 : 1;
        animate opacity { duration: Style.slow; }
    }
}
