// Area D: the downloads of this session, with their progress.

import { ListView } from "std-widgets.slint";
import { Style } from "style.slint";
import { Icons } from "icons.slint";
import { Art, ToolButton } from "widgets.slint";
import { App } from "globals.slint";
import { DownloadRow } from "dialogs-data.slint";
import { Button } from "dialog-widgets.slint";

component DownloadItem inherits Rectangle {
    in property <DownloadRow> download;
    in property <int> index;

    height: 64px;
    border-radius: Style.radius;
    background: hover.has-hover ? Style.hover : transparent;

    function state-text() -> string {
        if root.download.state == "waiting" {
            return @tr("Waiting");
        }
        if root.download.state == "resolving" {
            return @tr("Starting");
        }
        if root.download.state == "downloading" {
            return @tr("Downloading");
        }
        if root.download.state == "writing" {
            return @tr("Writing the file");
        }
        if root.download.state == "done" {
            return @tr("Done");
        }
        if root.download.state == "failed" {
            return @tr("Failed: {}", root.download.error);
        }
        ""
    }

    hover := TouchArea { }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 14px;

        Art {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            source: root.download.art;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.download.title;
                color: Style.text;
                overflow: elide;
            }
            Text {
                text: root.download.subtitle;
                color: Style.text-dim;
                font-size: 12px;
                overflow: elide;
            }
            // progress while it downloads
            if root.download.state == "downloading" || root.download.state == "writing": Rectangle {
                height: 3px;
                border-radius: 2px;
                background: #ffffff22;
                Rectangle {
                    x: 0;
                    width: parent.width * root.download.progress;
                    border-radius: 2px;
                    background: Style.accent;
                    animate width { duration: Style.normal; }
                }
            }
        }
        Text {
            max-width: 260px;
            horizontal-stretch: 0;
            text: root.state-text();
            color: root.download.state == "failed" ? #ff9a9f : Style.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.download.state == "failed": ToolButton {
            y: (parent.height - self.height) / 2;
            text: @tr("Retry");
            clicked => {
                App.retry-download(root.index);
            }
        }
        if root.download.state == "done": ToolButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.library;
            clicked => {
                App.open-download-folder(root.index);
            }
        }
    }
}

export component DownloadsView inherits Rectangle {
    VerticalLayout {
        padding-left: Style.margin;
        padding-right: Style.margin;
        padding-top: 24px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 4px;
            Text {
                horizontal-stretch: 1;
                text: @tr("Downloads");
                color: Style.text;
                font-size: 28px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Button {
                y: (parent.height - self.height) / 2;
                text: @tr("Open folder");
                clicked => {
                    App.open-download-folder(-1);
                }
            }
            Button {
                y: (parent.height - self.height) / 2;
                text: @tr("Clear finished");
                enabled: App.downloads.length > 0;
                clicked => {
                    App.clear-finished-downloads();
                }
            }
        }
        Text {
            text: @tr("Into {}. Right-click a song, album or playlist and choose Download.", App.download-folder);
            color: Style.text-dim;
            wrap: word-wrap;
        }

        if App.downloads.length > 0: ListView {
            vertical-stretch: 1;
            for row[i] in App.downloads: VerticalLayout {
                padding-bottom: 4px;
                DownloadItem {
                    download: row;
                    index: i;
                }
            }
        }
        if App.downloads.length == 0: Text {
            vertical-stretch: 1;
            text: @tr("Nothing downloaded yet.");
            color: Style.text-dim;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
