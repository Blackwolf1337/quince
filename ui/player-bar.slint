// Transport, what plays, volume and the queue switch, along the bottom.

import { Style } from "style.slint";
import { Icons } from "icons.slint";
import { Art, Centered, PlayButton, ThinSlider, ToolButton } from "widgets.slint";
import { Account, App, Player } from "globals.slint";
import { TrackLinks } from "track-links.slint";

export component PlayerBar inherits Rectangle {
    callback now-playing-requested();
    callback mini-player-requested();

    height: 92px;

    // seek line along the top edge; thicker with a knob under the pointer
    seek := ThinSlider {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        minimum: 0;
        maximum: Math.max(Player.duration, 0.01);
        value: Player.position;
        enabled: Player.duration > 0;
        fill: App.colored-progress ? Style.accent : Style.text;
        released(value) => {
            Player.seek(value);
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 18px;
        padding-top: 14px;
        spacing: 8px;
        alignment: stretch;

        Centered {
            ToolButton {
                icon: Icons.previous;
                enabled: Player.queue.length > 0;
                clicked => {
                    Player.previous();
                }
            }
        }
        Centered {
            PlayButton {
                playing: !Player.paused && !Player.idle;
                enabled: !Player.idle;
                play-icon: Icons.play;
                pause-icon: Icons.pause;
                clicked => {
                    Player.toggle-pause();
                }
            }
        }
        Centered {
            ToolButton {
                icon: Icons.next;
                enabled: Player.has-next;
                clicked => {
                    Player.next();
                }
            }
        }
        Text {
            text: Player.time(seek.shown) + " / " + Player.time(Player.duration);
            color: Style.text-dim;
            font-size: 13px;
            vertical-alignment: center;
        }

        Rectangle {
            width: 24px;
        }

        if Player.video-id != "": Centered {
            Rectangle {
                width: 56px;
                height: 56px;

                Art {
                    width: 100%;
                    height: 100%;
                    corner: 8px;
                    source: Player.art;
                    zoom: cover-touch.has-hover ? 1.08 : 1;
                    animate zoom { duration: Style.normal; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                }
                if Player.loading || Player.buffering: Rectangle {
                    border-radius: 8px;
                    background: #00000060;
                    Text {
                        text: "…";
                        color: Style.text;
                        font-size: 22px;
                    }
                }
                cover-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.now-playing-requested();
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 120px;
            alignment: center;
            spacing: 2px;
            Text {
                text: Player.title;
                color: Style.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
                TouchArea {
                    clicked => {
                        root.now-playing-requested();
                    }
                }
            }
            TrackLinks {
                font-size: 13px;
            }
        }

        if Account.signed-in && Player.video-id != "": Centered {
            ToolButton {
                icon: Icons.like;
                tooltip: @tr("Like");
                checked: Player.like-status == "LIKE";
                clicked => {
                    Player.rate(self.checked ? "INDIFFERENT" : "LIKE");
                }
            }
        }
        if Account.signed-in && Player.video-id != "": Centered {
            ToolButton {
                icon: Icons.dislike;
                tooltip: @tr("Dislike");
                checked: Player.like-status == "DISLIKE";
                clicked => {
                    Player.rate(self.checked ? "INDIFFERENT" : "DISLIKE");
                }
            }
        }

        Centered {
            ToolButton {
                icon: Icons.video;
                tooltip: @tr("Switch between song and music video");
                checked: App.video-mode;
                clicked => {
                    App.set-video-mode(!App.video-mode);
                    // the picture is in the Now Playing view
                    if !App.video-mode {
                        root.now-playing-requested();
                    }
                }
            }
        }

        if Player.video-id != "" && Player.stream-info != "": Text {
            text: Player.stream-info;
            color: Style.text-dim;
            font-size: 11px;
            opacity: 0.7;
            vertical-alignment: center;
        }

        // playback speed; shown when it is not 1x, the menu sets it
        if Player.speed != 1: Centered {
            speed := ToolButton {
                text: Math.round(Player.speed * 100) / 100 + "×";
                tooltip: @tr("Speed");
                clicked => {
                    speed-menu.show({ x: 0, y: -200px });
                }
                speed-menu := ContextMenuArea {
                    Menu {
                        MenuItem { title: "0.75×"; activated => { Player.set-speed(0.75); } }
                        MenuItem { title: "0.9×"; activated => { Player.set-speed(0.9); } }
                        MenuItem { title: "1×"; activated => { Player.set-speed(1); } }
                        MenuItem { title: "1.1×"; activated => { Player.set-speed(1.1); } }
                        MenuItem { title: "1.25×"; activated => { Player.set-speed(1.25); } }
                        MenuItem { title: "1.5×"; activated => { Player.set-speed(1.5); } }
                    }
                }
            }
        }

        Centered {
            ToolButton {
                icon: Player.muted ? Icons.volume-off : Icons.volume;
                clicked => {
                    Player.set-muted(!Player.muted);
                }
            }
        }
        Centered {
            ThinSlider {
                width: 120px;
                minimum: 0;
                maximum: 100;
                step: Player.volume-step;
                value: Player.volume;
                fill: Style.accent;
                track: Style.accent.with-alpha(0.3);
                thickness: 4px;
                active-thickness: 4px;
                knob-always: true;
                knob-color: Style.accent;
                tooltip: Math.round(Player.volume) + " %";
                moved(value) => {
                    Player.set-volume(value);
                }
            }
        }

        Centered {
            ToolButton {
                icon: Icons.queue;
                tooltip: @tr("Up next");
                checked: App.queue-open;
                clicked => {
                    App.queue-open = !App.queue-open;
                }
            }
        }
        Centered {
            ToolButton {
                icon: Icons.miniplayer;
                tooltip: @tr("Mini player");
                enabled: Player.video-id != "";
                clicked => {
                    root.mini-player-requested();
                }
            }
        }
        Centered {
            ToolButton {
                icon: Icons.chevron-left;
                rotation: 90;
                tooltip: @tr("Now playing");
                enabled: Player.video-id != "";
                clicked => {
                    root.now-playing-requested();
                }
            }
        }
    }
}
