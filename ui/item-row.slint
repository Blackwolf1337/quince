// One row of a list: a track in the queue (later also in pages and results).

import { Style } from "style.slint";
import { Icons } from "icons.slint";
import { Art } from "widgets.slint";
import { ListItem } from "globals.slint";

export component ItemRow inherits Rectangle {
    in property <ListItem> entry;
    in property <bool> current: root.entry.current;
    callback activated();

    height: 60px;
    border-radius: Style.radius;
    background: root.current ? Style.accent.with-alpha(0.1) : touch.has-hover ? Style.hover : transparent;
    opacity: root.entry.unavailable ? 0.4 : 1;
    animate background { duration: Style.fast; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        spacing: 14px;

        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;

            Art {
                width: 100%;
                height: 100%;
                source: root.entry.art;
                round: root.entry.kind == "artist";
            }
            Rectangle {
                visible: touch.has-hover;
                border-radius: 4px;
                background: #00000080;
                Image {
                    width: 22px;
                    height: 22px;
                    source: Icons.play;
                    colorize: white;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.entry.title;
                color: root.current ? Style.accent : Style.text;
                font-size: 15px;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                if root.entry.explicit: Rectangle {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: Style.text-dim;
                    Text {
                        text: "E";
                        color: Style.background;
                        font-size: 10px;
                        font-weight: 700;
                    }
                }
                Text {
                    text: root.entry.subtitle;
                    color: Style.text-dim;
                    font-size: 13px;
                    overflow: elide;
                }
            }
        }

        Text {
            text: root.entry.duration;
            color: Style.text-dim;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}
