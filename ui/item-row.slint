// One row of a list: a track in the queue or on a page, or an album, artist or
// playlist in search results.

import { Style } from "style.slint";
import { Icons } from "icons.slint";
import { Art } from "widgets.slint";
import { ListItem } from "globals.slint";

export component ItemRow inherits Rectangle {
    in property <ListItem> entry;
    in property <bool> current: root.entry.current;
    // the track number in the cover's place (album pages)
    in property <bool> show-index;
    // the play mark under the pointer
    in property <bool> playable: true;
    // picked for the item menu (Ctrl or Shift click)
    in property <bool> selected;
    callback activated();
    // a click with Ctrl (toggle) or Shift (range)
    callback select(string);

    private property <bool> control;
    private property <bool> shift;

    height: 60px;
    border-radius: Style.radius;
    background: root.selected ? Style.accent.with-alpha(touch.has-hover ? 0.24 : 0.18)
        : root.current ? Style.accent.with-alpha(0.1) : touch.has-hover ? Style.hover : transparent;
    opacity: root.entry.unavailable ? 0.4 : 1;
    animate background { duration: Style.fast; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        spacing: 14px;

        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;

            if !root.show-index: Art {
                width: 100%;
                height: 100%;
                source: root.entry.art;
                round: root.entry.kind == "artist";
            }
            if root.show-index && !touch.has-hover: Text {
                width: 100%;
                height: 100%;
                text: root.entry.number;
                color: root.current ? Style.accent : Style.text-dim;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                visible: touch.has-hover && root.playable;
                border-radius: 4px;
                background: root.show-index ? transparent : #00000080;
                Image {
                    width: 22px;
                    height: 22px;
                    source: Icons.play;
                    colorize: white;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.entry.title;
                color: root.current ? Style.accent : Style.text;
                font-size: 15px;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                if root.entry.explicit: Rectangle {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: Style.text-dim;
                    Text {
                        text: "E";
                        color: Style.background;
                        font-size: 10px;
                        font-weight: 700;
                    }
                }
                Text {
                    text: root.entry.subtitle;
                    color: Style.text-dim;
                    font-size: 13px;
                    overflow: elide;
                }
            }
        }

        Text {
            horizontal-stretch: 0;
            text: root.entry.duration;
            color: Style.text-dim;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.control = event.modifiers.control;
                root.shift = event.modifiers.shift;
            }
        }
        clicked => {
            if root.control {
                root.select("toggle");
            } else if root.shift {
                root.select("range");
            } else {
                root.activated();
            }
        }
    }
}
