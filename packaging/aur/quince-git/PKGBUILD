# Maintainer: MAINTAINER

pkgname=quince-git
pkgver=r0.0000000
pkgrel=1
pkgdesc='Native YouTube Music player (Slint, libmpv), newest master'
arch=('x86_64' 'aarch64')
url='https://github.com/Blackwolf1337/quince'
# Quince; MeCab (BSD option); QuickJS-ng; the IPADIC dictionary
license=('GPL-3.0-or-later' 'BSD-3-Clause' 'MIT' 'LicenseRef-IPADIC')
# libxkbcommon, wayland and the X11 libraries: loaded by Slint's windowing at run time
depends=('qt6-base' 'qt6-webengine' 'mpv' 'ffmpeg' 'icu' 'openssl' 'fontconfig' 'libglvnd' 'dbus'
         'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxi' 'hicolor-icon-theme')
makedepends=('rust' 'git' 'cmake' 'ninja' 'qt6-tools')
provides=('quince')
conflicts=('quince')
_mecab=0.996.13
_ipadic=2.7.0-20070801
_quickjs=0.17.0
_slint=1.18.1
_nfd=1.4.1
source=("quince::git+$url.git"
        "https://github.com/shogo82148/mecab/releases/download/v$_mecab/mecab-$_mecab.tar.gz"
        "https://github.com/shogo82148/mecab/releases/download/v$_mecab/mecab-ipadic-$_ipadic.tar.gz"
        "quickjs-$_quickjs.tar.gz::https://github.com/quickjs-ng/quickjs/archive/refs/tags/v$_quickjs.tar.gz"
        "slint-$_slint.tar.gz::https://github.com/slint-ui/slint/archive/refs/tags/v$_slint.tar.gz"
        "nfd-$_nfd.tar.gz::https://github.com/btzy/nativefiledialog-extended/archive/refs/tags/v$_nfd.tar.gz")
sha256sums=('SKIP'
            '3da28541062d6d1cfbb92ab09481779f2ad735c89705d981eb66f072ef776538'
            '74130f44264ce5b8cfa51e498b99345f71d2f854b74a9e9dfb6489e13e479e67'
            '559bc4c420475e55c7ab4510adbc562f55d7524d75e8e89d79ce4bb02f5687d9'
            'fe485305ed303215e76c04918ee9aefbffbe229f18f979098ec36c7fa1dab28b'
            '4a01eafa921169f009f3e83bea8e287d9e5d0b94ca9064cf7f0a546652d7c884')

prepare() {
  # Slint's crates, so the build needs no network either
  export CARGO_HOME="$srcdir/cargo"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')" --manifest-path "slint-$_slint/Cargo.toml"
  # Quince's changes to Slint: FetchContent applies them only to a Slint it downloads itself
  cd "slint-$_slint"
  cmake -P "$srcdir/quince/cmake/SlintPatch.cmake"
}

pkgver() {
  cd quince
  # 0.1.0.r12.gabc1234 after the first tag, r345.abc1234 before
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
    || printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  export CARGO_HOME="$srcdir/cargo" CARGO_NET_OFFLINE=true
  # the sources CMake would download, handed in so the build needs no network
  cmake -S quince -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DFETCHCONTENT_SOURCE_DIR_MECAB="$srcdir/mecab-$_mecab" \
    -DFETCHCONTENT_SOURCE_DIR_MECAB_IPADIC="$srcdir/mecab-ipadic-$_ipadic" \
    -DFETCHCONTENT_SOURCE_DIR_QUICKJS="$srcdir/quickjs-$_quickjs" \
    -DFETCHCONTENT_SOURCE_DIR_SLINT="$srcdir/slint-$_slint" \
    -DFETCHCONTENT_SOURCE_DIR_NFD="$srcdir/nativefiledialog-extended-$_nfd"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
