prepare() {
  # Slint's crates, so the build needs no network either; for all targets, as
  # Slint's build script runs cargo metadata (cbindgen)
  export CARGO_HOME="$srcdir/cargo"
  cargo fetch --locked --manifest-path "slint-$_slint/Cargo.toml"
  # Quince's changes to Slint: FetchContent applies them only to a Slint it downloads itself
  cd "slint-$_slint"
  cmake -P "$srcdir/$pkgname-$pkgver/cmake/SlintPatch.cmake"
}

build() {
  export CARGO_HOME="$srcdir/cargo" CARGO_NET_OFFLINE=true
  # the sources CMake would download, handed in so the build needs no network
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DFETCHCONTENT_SOURCE_DIR_MECAB="$srcdir/mecab-$_mecab" \
    -DFETCHCONTENT_SOURCE_DIR_MECAB_IPADIC="$srcdir/mecab-ipadic-$_ipadic" \
    -DFETCHCONTENT_SOURCE_DIR_QUICKJS="$srcdir/quickjs-$_quickjs" \
    -DFETCHCONTENT_SOURCE_DIR_SLINT="$srcdir/slint-$_slint" \
    -DFETCHCONTENT_SOURCE_DIR_CORROSION="$srcdir/corrosion-$_corrosion" \
    -DFETCHCONTENT_SOURCE_DIR_NFD="$srcdir/nativefiledialog-extended-$_nfd"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
