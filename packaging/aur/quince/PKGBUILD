# Maintainer: MAINTAINER

pkgname=quince
pkgver=0.1.1
pkgrel=1
pkgdesc='Native YouTube Music player (Slint, libmpv)'
arch=('x86_64' 'aarch64')
url='https://github.com/Blackwolf1337/quince'
# Quince; MeCab (BSD option); QuickJS-ng; the IPADIC dictionary
license=('GPL-3.0-or-later' 'BSD-3-Clause' 'MIT' 'LicenseRef-IPADIC')
# libxkbcommon, wayland and the X11 libraries: loaded by Slint's windowing at run time
depends=('qt6-base' 'webkitgtk-6.0' 'mpv' 'ffmpeg' 'icu' 'openssl' 'fontconfig' 'libglvnd' 'dbus'
         'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxi' 'hicolor-icon-theme')
makedepends=('rust' 'cmake' 'ninja' 'qt6-tools')
_mecab=0.996.13
_ipadic=2.7.0-20070801
_quickjs=0.17.0
_slint=1.18.1
_corrosion=0.6.1
_nfd=1.4.1
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "https://github.com/shogo82148/mecab/releases/download/v$_mecab/mecab-$_mecab.tar.gz"
        "https://github.com/shogo82148/mecab/releases/download/v$_mecab/mecab-ipadic-$_ipadic.tar.gz"
        "quickjs-$_quickjs.tar.gz::https://github.com/quickjs-ng/quickjs/archive/refs/tags/v$_quickjs.tar.gz"
        "slint-$_slint.tar.gz::https://github.com/slint-ui/slint/archive/refs/tags/v$_slint.tar.gz"
        "corrosion-$_corrosion.tar.gz::https://github.com/corrosion-rs/corrosion/archive/refs/tags/v$_corrosion.tar.gz"
        "nfd-$_nfd.tar.gz::https://github.com/btzy/nativefiledialog-extended/archive/refs/tags/v$_nfd.tar.gz")
sha256sums=('5bf2bcc9ac48939d56a2b33f9c8ca473e42010c9501521282441b50a40763ccc'
            '3da28541062d6d1cfbb92ab09481779f2ad735c89705d981eb66f072ef776538'
            '74130f44264ce5b8cfa51e498b99345f71d2f854b74a9e9dfb6489e13e479e67'
            '559bc4c420475e55c7ab4510adbc562f55d7524d75e8e89d79ce4bb02f5687d9'
            'fe485305ed303215e76c04918ee9aefbffbe229f18f979098ec36c7fa1dab28b'
